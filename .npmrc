# vite-plugin-pwa@1.2.0 peer range caps at vite ^7; we use vite@^8.
# legacy-peer-deps lets `npm ci` proceed in CI and local installs without
# the --legacy-peer-deps flag on every command. Tracked for a proper
# resolution (either downgrading vite or swapping PWA library) in a
# follow-up PR.
legacy-peer-deps=true

# Supply-chain hardening (R4-SEC-002): never run dependency lifecycle scripts
# (preinstall / install / postinstall / prepare) during npm ci / npm install.
# A hijacked package's postinstall would otherwise run with full access to the
# home directory on every install, including main-sync's automatic one.
# None of the locked packages needs its install step (see
# docs/plans/2026-09-30-r4-sec-002-install-scripts.md). If one ever does, add
# an explicit, reviewed `npm rebuild <pkg>` instead of removing this line.
# Side effect: our own `prepare` no longer runs on install; run
# `npm run prepare` once after a fresh clone (git hooks + MCP server deps).
ignore-scripts=true
