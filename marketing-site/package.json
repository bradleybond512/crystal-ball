{
  "name": "crystal-ball-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run generate && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run generate && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "npm run generate && tsc --noEmit",
    "generate": "node scripts/generate-site-data.mjs && node scripts/generate-discovery.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261018.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.4",
    "wrangler": "4.151.1",
    "lightningcss": "1.31.1",
    "terser": "5.47.1",
    "braces": "file:vendor/braces"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    },
    "braces": "$braces"
  },
  "type": "module"
}
