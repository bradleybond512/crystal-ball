{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "root_causes",
    "recommended_actions",
    "blocking_findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "root_causes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "recommended_actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "blocking_findings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
