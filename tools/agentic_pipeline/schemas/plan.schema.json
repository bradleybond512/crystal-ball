{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "tasks",
    "risks",
    "rollback",
    "approval_gates"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "allowed_files",
          "acceptance_criteria",
          "validation_commands"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "allowed_files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "validation_commands": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "approval_gates": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "enum": [
          "design",
          "control_plane",
          "publish",
          "release",
          "deploy",
          "secrets",
          "destructive"
        ]
      }
    }
  }
}
