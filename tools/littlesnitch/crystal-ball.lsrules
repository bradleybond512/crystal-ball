{
  "name": "Crystal Ball",
  "description": "Network rules for Crystal Ball intelligence dashboard. Allows required API endpoints for data feeds, LLM, maps, threat intel, and local services.",
  "rules": [
    {
      "action": "allow",
      "process": "/Users/bradleybond/Applications/Crystal Ball.app/Contents/MacOS/crystalball",
      "remote-addresses": "127.0.0.1",
      "ports": "46123",
      "protocol": "tcp",
      "notes": "Sidecar API (local Node.js server)"
    },
