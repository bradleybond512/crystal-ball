# Supply-chain hardening (R4-SEC-002): never run dependency lifecycle scripts
# (preinstall / install / postinstall / prepare) during npm ci / npm install.
# A hijacked package's postinstall would otherwise run with full access to the
# home directory on every install, including main-sync's automatic one.
# None of the locked packages needs its install step (see
# docs/plans/2026-09-30-r4-sec-002-install-scripts.md). If one ever does,
# never remove this line. Review that exact package version's scripts first,
# then run them for that one package only:
#   npm rebuild <pkg> --ignore-scripts=false
# A plain `npm rebuild <pkg>` inherits ignore-scripts=true and skips them.
# Security: the flag runs that package's install scripts with your user's full
# access (home directory, keys, network), so never use it unreviewed, without a
# package name, or in an automated install.
ignore-scripts=true
